# --- memory-sync server configuration ---
# Copy to .env and fill in real values. Everything with "replace-with" must change.

# Public HTTPS domain that resolves to this server (Caddy issues the cert).
SYNC_DOMAIN=sync.example.com
# Email used for Let's Encrypt certificate notifications.
ACME_EMAIL=you@example.com

# PostgreSQL superuser for the app database (used at first boot only).
POSTGRES_DB=memory_sync
POSTGRES_USER=memory_sync_admin
POSTGRES_PASSWORD=replace-with-32-plus-random-admin-password

# Restricted app role (least privilege, NOBYPASSRLS) used by the API.
APP_DB_USER=memory_sync_app
APP_DB_PASSWORD=replace-with-32-plus-random-app-password

# API connection string (inside the compose network, host = postgres).
DATABASE_URL=postgresql://memory_sync_app:replace-with-32-plus-random-app-password@postgres:5432/memory_sync

# HS256 secret for access tokens. Use at least 64 random characters:
#   openssl rand -base64 48
JWT_SECRET=replace-with-at-least-64-random-characters

# Invite code gate. LEAVE EMPTY to allow open registration (recommended for
# self-hosted private servers). Set a value to require it on /v1/auth/register.
REGISTRATION_INVITE_CODE=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEVICE_CLOCK_SKEW_SECONDS=300
MAX_CONTENT_BYTES=1048576
# Must match Caddyfile request_body max_size (1258291).
MAX_REQUEST_BYTES=1258291
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Backup scripts only.
BACKUP_DIR=/var/backups/memory-sync
BACKUP_RETENTION_DAYS=14
